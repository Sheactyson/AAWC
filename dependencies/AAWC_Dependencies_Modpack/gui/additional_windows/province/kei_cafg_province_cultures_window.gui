                    tooltip = "kCAFG_debug_convert_to_my_culture"
                    using = tooltip_nw
                    color = { 1 0.7 1 1 }

                    highlight_icon = {
                        parentanchor = center
                        size = { 100% 100% }
                        texture = "gfx/interface/icons/flat_icons/plus.dds"
		                using = Master_Button_Modify_Texture
                        color = { 1 0.7 1 1 }
                    }
                }

                button_round = {
                    size = { 18 18 }
                    parentanchor = vcenter|right
                    position = { -62 12 }
                    button_ignore = none
                    visible = "[GetScriptedGui( 'kCAFG_DEBUG_province_culture_convert' ).IsShown( GuiScope.SetRoot( Province.MakeScope ).AddScope('culture', Culture.MakeScope).AddScope('local_player', GetPlayer.MakeScope).End)]"
                    enabled = "[GetScriptedGui( 'kCAFG_DEBUG_province_culture_convert' ).IsValid( GuiScope.SetRoot( Province.MakeScope ).AddScope('culture', Culture.MakeScope).AddScope('local_player', GetPlayer.MakeScope).End)]"
                    onclick = "[GetScriptedGui( 'kCAFG_DEBUG_province_culture_convert' ).Execute( GuiScope.SetRoot( Province.MakeScope ).AddScope('culture', Culture.MakeScope).AddScope('local_player', GetPlayer.MakeScope).AddScope('amount', MakeScopeValue(EmptyScope.ScriptValue('V_kCAFG_debug_conversion_amount'))).End)]"
                    onrightclick = "[GetScriptedGui( 'kCAFG_DEBUG_province_culture_convert' ).Execute( GuiScope.SetRoot( Province.MakeScope ).AddScope('culture', Culture.MakeScope).AddScope('local_player', GetPlayer.MakeScope).AddScope('amount', MakeScopeValue(EmptyScope.ScriptValue('V_kCAFG_debug_conversion_amount_high'))).End)]"
