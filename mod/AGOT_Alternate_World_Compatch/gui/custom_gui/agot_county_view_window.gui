#############################################################
################# AGOT COUNTY VIEW WINDOW ###################
#############################################################

types CountyViewTypes
{
	####################
	# TITLES AND NAMES #
	####################
	type agot_county_view_foreign_county_iron_throne = text_single
	{
		name = "foreign_county_iron_throne"
		visible = "[And(HasIronThroneTopLiege, Not(Or(ObjectsEqual( Character.Self, GetPlayer ),Character.IsOtherLiegeOrAbove( GetPlayer ))))]"
		layoutpolicy_horizontal = expanding
		text = "AGOT_HOLDING_VIEW_COUNTY_SEVEN_KINGDOMS"
		margin_bottom = 5
		using = Font_Size_Small
		fontsize_min = 10
		max_width = 420
	}

	#################
	# RUINS RESTORE #
	#################
	#type agot_county_view_restore_ruins_button = button_standard_big
	#{
	#	name = "restore_ruins"
	#	datacontext = "[HoldingView.GetTitle]"
	#	visible = "[And( GetScriptedGui('agot_is_ruin').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), Not(GetScriptedGui('lv_use_custom_colonization').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End)) )]"

	#	position = { 5 -5 }
	#	size = { 235 55 }
	#	text = "agot_ruin_begin_reconstruction"
	#	tooltip = "[HoldingView.GetProvince.Custom('RuinsReconstructTooltip')]"
	#	enabled = "[GetScriptedGui('can_reconstruct_ruin').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope ).End)]"
	#	onclick = "[GetVariableSystem.Toggle('window_ruins_confirm')]"
	#}

	# Transformed this into a container holding both the AGOT button and LoV's
	# That way, even IF someone still has a mod that conflicts with the county UI, at least the button will work provided it's patched for AGOT
	type agot_county_view_restore_ruins_button = vbox
	{
		# Failsafes
		# If another submod conflicts with the county view, have these as failsafes for calculating the costs
		state = {
			name = _show
			on_finish = "[GetScriptedGui('lv_restore_ruins_tooltip_show').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
		}
		# Too clunky
		#state = {
		#	name = _hide
		#	on_finish = "[GetScriptedGui('lv_restore_ruins_tooltip_hide').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
		#}

		button_standard_big = {
			name = "restore_ruins"
			datacontext = "[HoldingView.GetTitle]"
			visible = "[And( GetScriptedGui('aawc_is_restorable_ruin').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), Not(GetScriptedGui('lv_use_custom_colonization').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End)) )]"
			state = {
				name = _mouse_hierarchy_enter
				on_finish = "[GetScriptedGui('lv_restore_ruins_tooltip_show').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
			}

			#position = { 5 -5 }
			size = { 235 55 }
			text = "agot_ruin_begin_reconstruction"
			tooltip = "[HoldingView.GetProvince.Custom('RuinsReconstructTooltip')]"
			enabled = "[And(GetScriptedGui('can_reconstruct_ruin').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_reclaim_cost_rh'))))]"
			onclick = "[GetVariableSystem.Toggle('window_ruins_confirm')]"
		}
		button_standard_big = {
			name = "lv_restore_ruins"
			datacontext = "[HoldingView.GetTitle]"
			visible = "[And( GetScriptedGui('aawc_is_restorable_ruin').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), GetScriptedGui('lv_use_custom_colonization').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End) )]"
			state = {
				name = _mouse_hierarchy_enter
				on_finish = "[GetScriptedGui('lv_restore_ruins_tooltip_show').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
			}

			#position = { 5 -5 }
			size = { 235 55 }
			text = "agot_ruin_begin_reconstruction"
			enabled = "[And(GetScriptedGui('aawc_begin_lov_expedition_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_reclaim_cost_rh'))))]"
			onclick = "[GetScriptedGui('aawc_begin_lov_expedition_from_gui').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
			tooltip = "[SelectLocalization( GetScriptedGui('aawc_begin_lov_expedition_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), 'aawc_population_reclaim_button_tooltip', 'aawc_population_reclaim_button_blocked_tooltip' )]"
		}
	}

	type agot_county_view_ruins_reconstruct_confirm = window
	{
		allow_outside = yes
		movable = yes
		parentanchor = center
		position = { 640 -300 }
		visible = "[GetVariableSystem.Exists('window_ruins_confirm')]"
		alwaystransparent = no
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		using = Window_Background
		using = Window_Decoration

		# LEGACY OF VALYRIA ADDED
		state = {
			name = _hide
			on_start = "[GetVariableSystem.Clear( 'window_ruins_confirm' )]"
		}

		vbox = {
			set_parent_size_to_minimum = yes
			margin = { 20 20 }

			hbox = {
				margin_bottom = -10
				margin = { 20 0 }
				layoutpolicy_horizontal = expanding
				parentanchor = top

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text" {
						text = "reconstruct_ruin_confirm_title"
					}

					blockoverride "button_close" {
						visible = no
					}
				}
			}

			hbox = {
				margin = { 40 20 }
				text_single = {
					multiline = yes
					max_width = 500
					align = center
					text = "[HoldingView.GetProvince.Custom('RuinsReconstructDesc')]"
				}
			}

			## Send Button
			hbox = {
				name = "confirm_button"
				margin = { 20 10 }
				margin_bottom = 15
				spacing = 3

				button_primary_big = {
					text = "reconstruct_ruin_confirm_button"
					enabled = "[And(GetScriptedGui('can_reconstruct_ruin').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_reclaim_cost_rh'))))]"

					onclick = "[GetScriptedGui('reconstruct_ruin').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
					onclick = "[GetVariableSystem.Toggle('window_ruins_confirm')]"
				}
			}
		}
	}

	######################
	# SETTLEMENT BUTTONS #
	######################
	type agot_county_view_settlement_buttons = widget
	{
		allow_outside = yes
		parentanchor = right|top

		vbox = {
			ignoreinvisible = yes

			position = { -265 110 }

			button_round  = { ## RETURN SETTLEMENT BACK TO WILDERNESS ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('return_settlement_county_to_wilderness', Title.Self) )]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('return_settlement_county_to_wilderness', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('return_settlement_county_to_wilderness', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('return_settlement_county_to_wilderness', Title.Self)]"

				button_abandon_holding = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			button_round  = { ## FEUDALIZE INTO CASTLE HOLDING ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And(And(And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('feudalize_into_castle_holding_interaction', Title.Self) ), Not(GetScriptedGui('aawc_feudalize_owned_settlement_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End))), Not(GetScriptedGui('aawc_feudalize_owned_tribal_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)))]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('feudalize_into_castle_holding_interaction', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('feudalize_into_castle_holding_interaction', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('feudalize_into_castle_holding_interaction', Title.Self)]"

				button_feudalize_holding = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			button_round  = { ## FEUDALIZE INTO CITY HOLDING ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And(And(And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('feudalize_into_city_holding_interaction', Title.Self) ), Not(GetScriptedGui('aawc_feudalize_owned_settlement_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End))), Not(GetScriptedGui('aawc_feudalize_owned_tribal_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)))]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('feudalize_into_city_holding_interaction', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('feudalize_into_city_holding_interaction', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('feudalize_into_city_holding_interaction', Title.Self)]"

				button_feudalize_holding_city = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			button_round  = { ## FEUDALIZE INTO TEMPLE HOLDING ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And(And(And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('feudalize_into_temple_holding_interaction', Title.Self) ), Not(GetScriptedGui('aawc_feudalize_owned_settlement_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End))), Not(GetScriptedGui('aawc_feudalize_owned_tribal_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)))]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('feudalize_into_temple_holding_interaction', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('feudalize_into_temple_holding_interaction', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('feudalize_into_temple_holding_interaction', Title.Self)]"

				button_feudalize_holding_temple = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			button_round  = { ## TRIBALIZE A HOLDING ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('tribalize_settlement_holding_interaction', Title.Self) )]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('tribalize_settlement_holding_interaction', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('tribalize_settlement_holding_interaction', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('tribalize_settlement_holding_interaction', Title.Self)]"

				button_feudalize_holding = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			button_round  = { ## COLONIZE A PIRATE DEN ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('colonize_pirate_den_interaction', Title.Self) )]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('colonize_pirate_den_interaction', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('colonize_pirate_den_interaction', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('colonize_pirate_den_interaction', Title.Self)]"

				button_feudalize_holding = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}

			button_round  = { ## PIRATIZE A CASTLE ###
				datacontext = "[HoldingView.GetGUIHoldingBuilding]"
				datacontext = "[HoldingView.GetTitle]"
				datacontext = "[HoldingView.GetHolder]"
				visible = "[And( Character.IsLocalPlayer, Character.IsPlayerInteractionShownAndCanPickTitle('pirate_takeover_of_holding_interaction', Title.Self) )]"
				enabled = "[Character.IsPlayerInteractionWithTargetTitleValid('pirate_takeover_of_holding_interaction', Title.Self)]"
				tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip('pirate_takeover_of_holding_interaction', Title.Self)]"
				oversound = "event:/SFX/UI/Generic/sfx_ui_generic_pointer_over"
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
				onclick = "[Character.OpenPlayerInteractionWithTargetTitle('pirate_takeover_of_holding_interaction', Title.Self)]"

				button_feudalize_holding = {
					size = { 25 25 }
					parentanchor = center
					alwaystransparent = yes
				}
			}
		}
	}

	# Transformed this into a container holding both the AGOT button and LoV's
	# That way, even IF someone still has a mod that conflicts with the county UI, at least the button will work provided it's patched for AGOT
type agot_county_view_colonize_button = vbox
{
	vbox = {
		visible = "[And(GetScriptedGui('aawc_is_restorable_ruin').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), And(GetScriptedGui('lv_use_custom_colonization').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), HoldingView.GetProvince.GetTitle.IsCountyCapital))]"
		hbox = {
			margin_bottom = 15
			visible = "[Not(IsObserver)]"
			button_standard_big = {
				name = "aawc_reclaim_ruin_from_county_view"
				datacontext = "[HoldingView.GetTitle]"

				size = { 300 50 }
				text = "[Localize('AAWC_POPULATION_RECLAIM')] [HoldingView.GetProvince.GetCounty.GetTitle.GetNameNoTierNoTooltip]"
				onclick = "[GetScriptedGui('aawc_begin_lov_expedition_from_gui').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
				tooltip = "[SelectLocalization( GetScriptedGui('aawc_begin_lov_expedition_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), 'aawc_population_reclaim_button_tooltip', 'aawc_population_reclaim_button_blocked_tooltip' )]"
				enabled = "[And(GetScriptedGui('aawc_begin_lov_expedition_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_reclaim_cost_rh'))))]"
			}
		}
	}

	# AGE OF SILENCE: the camp must already be inside this wilderness county.
	vbox = {
		visible = "[GetScriptedGui('aawc_age_of_silence_settle_wilderness_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
		hbox = {
			margin_bottom = 15
			visible = "[Not(IsObserver)]"
			button_standard_big = {
				name = "aawc_age_of_silence_settle_wilderness"
				datacontext = "[HoldingView.GetTitle]"

				size = { 300 50 }
				text = "[Localize('AAWC_AGE_OF_SILENCE_SETTLE')] [HoldingView.GetProvince.GetCounty.GetTitle.GetNameNoTierNoTooltip]"
				onclick = "[GetScriptedGui('aawc_age_of_silence_settle_wilderness_from_gui').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
				tooltip = "AAWC_AGE_OF_SILENCE_SETTLE_TT"
				enabled = "[GetScriptedGui('aawc_age_of_silence_settle_wilderness_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
			}
		}
	}

	# ORIGINAL
	vbox = {
			visible = "[And(Not(GetScriptedGui('aawc_age_of_silence_colonizer_mode').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)), And(GetScriptedGui('aawc_is_colonizable_wilderness').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), And(Not(GetScriptedGui('lv_use_custom_colonization').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End)), HoldingView.GetProvince.GetTitle.IsCountyCapital) ))]"
			hbox = {
				margin_bottom = 15
				visible = "[Not(IsObserver)]"
				button_standard_big = {
					name = "construct_holding_wilderness"
					datacontext = "[HoldingView.GetTitle]"

					size = { 300 50 }
					text = "[Localize('COLONIZE')] [HoldingView.GetProvince.GetCounty.GetTitle.GetNameNoTierNoTooltip]"
					onclick = "[GetScriptedGui('agot_can_colonize').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('wilderness', HoldingView.GetProvince.MakeScope ).End)]"
					tooltip = "[SelectLocalization(And(GetScriptedGui('agot_can_colonize').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('wilderness', HoldingView.GetProvince.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_colonize_cost_wh')))), 'aawc_population_colonize_button_tooltip', 'aawc_population_colonize_button_blocked_tooltip')]"
					enabled = "[And(GetScriptedGui('agot_can_colonize').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('wilderness', HoldingView.GetProvince.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_colonize_cost_wh'))))]"
				}
			}
		}
		
		# LEGACY OF VALYRIA ADDED
		vbox = {
			visible = "[And(Not(GetScriptedGui('aawc_age_of_silence_colonizer_mode').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)), And(GetScriptedGui('aawc_is_colonizable_wilderness').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), And(GetScriptedGui('lv_use_custom_colonization').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End), HoldingView.GetProvince.GetTitle.IsCountyCapital)))]"
			hbox = {
				margin_bottom = 15
				visible = "[Not(IsObserver)]"
				button_standard_big = {
					name = "construct_holding_wilderness"
					datacontext = "[HoldingView.GetTitle]"

					size = { 300 50 }
					text = "[Localize('COLONIZE')] [HoldingView.GetProvince.GetCounty.GetTitle.GetNameNoTierNoTooltip]"
					onclick = "[GetScriptedGui('aawc_begin_lov_wilderness_expedition_from_gui').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
					tooltip = "[SelectLocalization(And(GetScriptedGui('aawc_begin_lov_wilderness_expedition_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_colonize_cost_wh')))), 'aawc_population_colonize_button_tooltip', 'aawc_population_colonize_button_blocked_tooltip')]"
					enabled = "[And(GetScriptedGui('aawc_begin_lov_wilderness_expedition_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), Not(LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetCountyTitle.MakeScope.ScriptValue('aawc_population_county_colonize_cost_wh'))))]"
				}
			}
		}

		vbox = {
			visible = "[GetScriptedGui('aawc_establish_owned_settlement_from_gui').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
			margin_bottom = 15
			text_single = {
				text = "AAWC_POPULATION_OWNED_SETTLEMENT_TITLE"
				default_format = "#high"
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				text = "AAWC_POPULATION_OWNED_SETTLEMENT_INFO"
			}
			text_single = {
				raw_text = "[Localize('AAWC_POPULATION_ESTABLISH_SETTLEMENT_POP_COST')]: #high [FixedPointToInt(HoldingView.GetProvince.MakeScope.ScriptValue('aawc_population_owned_settlement_population_cost'))]#! ([Localize('AAWC_POPULATION_AVAILABLE')]: #high [FixedPointToInt(GetPlayer.MakeScope.Var('aawc_population_available').GetValue)]#!)"
			}
			text_single = {
				visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.Var('aawc_population_available').GetValue, HoldingView.GetProvince.MakeScope.ScriptValue('aawc_population_owned_settlement_population_cost'))]"
				raw_text = "#N ([Localize('AAWC_POPULATION_MISSING')]: [FixedPointToInt(Subtract_CFixedPoint(HoldingView.GetProvince.MakeScope.ScriptValue('aawc_population_owned_settlement_population_cost'), GetPlayer.MakeScope.Var('aawc_population_available').GetValue))])#!"
			}
			text_single = {
				raw_text = "[Localize('AAWC_POPULATION_ESTABLISH_SETTLEMENT_GOLD_COST')]: #high [FixedPointToInt(HoldingView.GetProvince.MakeScope.ScriptValue('aawc_population_owned_settlement_gold_cost'))]#! [gold_i] ([Localize('AAWC_POPULATION_AVAILABLE')]: #high [FixedPointToInt(GetPlayer.GetGold)]#!)"
			}
			text_single = {
				visible = "[LessThan_CFixedPoint(GetPlayer.GetGold, HoldingView.GetProvince.MakeScope.ScriptValue('aawc_population_owned_settlement_gold_cost'))]"
				raw_text = "#N ([Localize('AAWC_POPULATION_MISSING')]: [FixedPointToInt(Subtract_CFixedPoint(HoldingView.GetProvince.MakeScope.ScriptValue('aawc_population_owned_settlement_gold_cost'), GetPlayer.GetGold))])#! [gold_i]"
			}
			button_standard_big = {
				name = "aawc_establish_owned_settlement"
				datacontext = "[HoldingView.GetTitle]"

				size = { 300 50 }
				text = "AAWC_POPULATION_ESTABLISH_SETTLEMENT"
				enabled = "[GetScriptedGui('aawc_establish_owned_settlement_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
				onclick = "[GetScriptedGui('aawc_establish_owned_settlement_from_gui').Execute( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End)]"
				tooltip = "[SelectLocalization(GetScriptedGui('aawc_establish_owned_settlement_from_gui').IsValid( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).AddScope('actor', GetPlayer.MakeScope ).End), 'AAWC_POPULATION_ESTABLISH_SETTLEMENT_TT_OK', 'AAWC_POPULATION_ESTABLISH_SETTLEMENT_TT_BLOCKED')]"
			}
		}

	}

	####################
	# DRAGONPIT BUTTON #
	####################
	type agot_county_view_dragonpit_button = widget
	{
		size = { 30 30 } # LEGACY OF VALYRIA MODIFIED
		button_icon = { # LEGACY OF VALYRIA MODIFIED
			name = "VIEW_DRAGONPIT_DRAGONS"
			datacontext = "[GetScriptedGui( 'agot_view_dragons_in_dragonpit' )]"
			visible = "[GetScriptedGui('agot_view_dragons_in_dragonpit').IsShown( GuiScope.SetRoot( HoldingView.GetProvince.MakeScope ).End)]"
			tooltip = "VIEW_DRAGONPIT_DRAGONS_TT"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'dp_county', Province.MakeScope ).End)]"
			position = { 0 0 }
			parentanchor = center
			size = { 28 28 } # LEGACY OF VALYRIA MODIFIED
			texture = "gfx/interface/icons/flat_icons/view_dragonpit.dds"
		}
	}

	# LEGACY OF VALYRIA CUSTOM TYPES
	type lv_colonization_button_tooltip = container
	{
		using = GeneralTooltipSetup
		alwaystransparent = no

		object_tooltip_pop_out = {
			blockoverride "title_text" {
				raw_text = "[Title.GetNameWithUnderlyingNoTooltip|U]"
			}

			blockoverride "subheading" {
				text_single = {
					layoutpolicy_horizontal = expanding
					raw_text = "[HoldingView.GetProvince.Custom('LV_RuinsReconstructTooltip_RuinType')]"
				}
			}

			blockoverride "concept_link" {}

			blockoverride "main_description" {
				vbox = {
					layoutpolicy_horizontal = expanding

					cooltip_paragraph = { text = "[GetPlayer.Custom('LV_RuinsReconstructTooltip')]" }
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = { text = "lv_ruins_reconstruct_tooltip_cost" }
						text_single = {
							margin_left = 6
							text = "lv_ruins_reconstruct_tooltip_cost_value"
							default_format = "#game_link"

							tooltipwidget = {
								container = {
									using = GeneralTooltipSetup
									alwaystransparent = no

									object_tooltip_pop_out = {
										blockoverride "title_text" { text = "lv_ruins_reconstruct_tooltip_breakdown_title" }
										blockoverride "subheading" {
											text_single = {
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_subheading"
											}
										}
										blockoverride "main_description" {
											# Settlement Cost Breakdown
											text_single = {
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_settlement"
											}
											text_single = {
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_settlement_base"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_valyrian_architecture').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ruin', HoldingView.GetProvince.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_settlement_valyrian_architecture"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_hard_working').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_settlement_hard_working"
											}
											
											spacer = { size = { 0 6 } }

											# Expedition Cost Breakdown
											text_single = {
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition"
											}
											text_single = {
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_base"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_isolationist').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_isolationist"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_republican_legacy').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ruin', HoldingView.GetProvince.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_republican_legacy"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_valyrian').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ruin', HoldingView.GetProvince.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_valyrian"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_north_valyrian_1').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ruin', HoldingView.GetProvince.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_north_valyrian_1"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_north_valyrian_2').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ruin', HoldingView.GetProvince.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_north_valyrian_2"
											}
											text_single = {
												visible = "[GetScriptedGui('lv_restore_ruins_tooltip_culture_doom').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ruin', HoldingView.GetProvince.MakeScope ).End)]"
												layoutpolicy_horizontal = expanding
												text = "lv_ruins_reconstruct_tooltip_breakdown_expedition_doom"
											}
										}
									}
								}
							}
						}
						expand = {}
					}
					#text_single = {
					#	visible = "[Not(GetScriptedGui('can_reconstruct_ruin').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope ).End))]"
					#	layoutpolicy_horizontal = expanding
					#	text = "colonize_land_holding_desc"
					#}
					text_single = {
						visible = "[Not(GetScriptedGui('can_reconstruct_ruin').IsValid(GuiScope.SetRoot(HoldingView.GetProvince.MakeScope).AddScope('actor', GetPlayer.MakeScope ).End))]"
						layoutpolicy_horizontal = expanding
						text = "lv_ruins_reconstruct_tooltip_cost_insufficient"
					}
				}
			}
		}
	}
}
